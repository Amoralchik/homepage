{
  "manifest_version": 3,
  "name": "Home",
  "version": "1.5.0",
  "description": "Pixel-art start page: day/night sky, 13 backgrounds, greeting, quotes/notes/pomodoro widgets, custom links, bangs and a bookmarks bar.",
  "permissions": ["tabs", "storage", "bookmarks", "geolocation", "favicon"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://suggestqueries.google.com/*",
    "https://duckduckgo.com/*",
    "https://ac.duckduckgo.com/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://ipwho.is/*"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  }
}
